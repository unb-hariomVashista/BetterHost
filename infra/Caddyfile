# Caddyfile for BetterHost VPS Deployment
# Replace 'yourdomain.com' with your actual domain name!

# Option 1: Separate Subdomains (Recommended)
# Frontend Web App
app.yourdomain.com {
    reverse_proxy localhost:3005
}

# Go Backend API & Static Project Server
api.yourdomain.com {
    reverse_proxy localhost:8085
}

# Option 2: Single Domain Setup (Alternative)
# If using single domain, append this block to your existing Caddyfile:
# yourdomain.com {
#     # Route API requests to Go API
#     handle /api/* {
#         reverse_proxy localhost:8085
#     }
#
#     # Route Static Deployment Preview URLs to Go API
#     handle /projects/* {
#         reverse_proxy localhost:8085
#     }
#
#     # Route all other web UI requests to Next.js Frontend
#     handle {
#         reverse_proxy localhost:3005
#     }
# }
